# Copy this file to .env and adjust values for local development.

# MongoDB connection string (obrigatório para rodar localmente)
# Usa localhost:27018 pois é a porta exposta no host pelo docker-compose.yml
# (mapeamento "27018:27017" — dentro da rede do compose o Mongo continua na 27017).
MONGODB_URI=mongodb://localhost:27018/contract_finder

# Set to 1 to use local HTML files from ../.tests/ instead of hitting the portal.
# Useful for testing parsing logic without needing valid credentials.
# NUXT_MOCK=1
